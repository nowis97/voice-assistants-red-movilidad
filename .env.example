# Número de tarjeta Bip! por defecto (8 dígitos)
DEFAULT_BIP_NUMBER=12345678

# Código de paradero habitual (ejemplo: PA345, PC186, PI1814)
DEFAULT_STOP_CODE=PA345

# Recorrido de micro habitual (ejemplo: 401, 506, B02)
DEFAULT_SERVICE=401

# ID de la Skill de Alexa (opcional, para validar requests en Lambda)
ALEXA_SKILL_ID=amzn1.ask.skill.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Puerto para pruebas locales con servidor HTTP
PORT=8000
